# Vitrine que Fala — example environment. Copy to .env and adjust.
# All defaults below work on an 8 GB RAM notebook.

# --- AI service -------------------------------------------------------------
# stub  = deterministic fake pipeline (no model download, CI/demo friendly)
# florence = real open-source pipeline: Florence-2-base caption + one
#            Opus-MT pair per locale + Tesseract OCR (v2.0: 6 locales)
PIPELINE=stub
# Text embeddings for semantic search (ADR-0009): stub = deterministic
# offline vectors; e5 = multilingual-e5-small (~0.5 GB, lazy-loaded)
EMBEDDER=stub
# Tesseract language packs used for OCR (v2.0 reads all six markets)
TESSERACT_LANGS=por+eng+ind+tha+vie+chi_tra
# Internal base URL used by the worker and catalog to reach the AI service
AI_SERVICE_URL=http://ai:8083

# --- Event broker (ADR-0008) --------------------------------------------------
# redis  = Redis Streams (local and CI default)
# pubsub = Google Cloud Pub/Sub (PUBSUB_PROJECT required; PUBSUB_EMULATOR_HOST
#          supported for local experiments)
BROKER=redis
PUBSUB_PROJECT=vitrine-local

# --- Datastores -------------------------------------------------------------
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=vitrine-dev
POSTGRES_DB=vitrine
REDIS_ADDR=redis:6379

# --- Gateway ----------------------------------------------------------------
# Change in production (see infra/cloud-run.md)
JWT_SECRET=dev-secret-change-me
# gRPC mesh addresses (ADR-0007)
GRPC_CATALOG_ADDR=catalog:9081
GRPC_ORDER_ADDR=order:9082
# HTTP fallbacks for multipart upload and the AI proxy
CATALOG_URL=http://catalog:8081
AI_URL=http://ai:8083

# --- Web (Vite dev server) --------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1
