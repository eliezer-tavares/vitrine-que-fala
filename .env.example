# Vitrine que Fala — example environment. Copy to .env and adjust.
# All defaults below work on an 8 GB RAM notebook.

# --- AI service -------------------------------------------------------------
# stub  = deterministic fake pipeline (no model download, CI/demo friendly)
# florence = real open-source pipeline: Florence-2-base caption + Opus-MT en->pt + Tesseract OCR
PIPELINE=stub
# Tesseract language packs used for OCR (v1.0 reads por+eng)
TESSERACT_LANGS=por+eng
# Internal base URL used by the worker to reach the AI service
AI_SERVICE_URL=http://ai:8083

# --- Datastores -------------------------------------------------------------
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=vitrine-dev
POSTGRES_DB=vitrine
REDIS_ADDR=redis:6379

# --- Gateway ----------------------------------------------------------------
# Change in production (see infra/cloud-run.md)
JWT_SECRET=dev-secret-change-me
CATALOG_URL=http://catalog:8081
ORDER_URL=http://order:8082
AI_URL=http://ai:8083

# --- Web (Vite dev server) --------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1
